{
  "manifest_version": 3,
  "name": "میو بوک | دستیار و کتابخانه محلی کتاب‌خوان‌ها",
  "version": "1.0.0",
  "description": "دستیار مطالعه هوشمند، یادداشت‌نویسی حاشیه‌ای، زمان‌سنج تمرکز و ردیاب آمار مطالعه کاملا آفلاین.",
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab",
    "contextMenus",
    "identity"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "chrome_url_overrides": {
    "newtab": "dashboard/dashboard.html"
  },
  "action": {
    "default_title": "باز کردن میو بوک",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["scripts/content.js"],
      "css": ["styles/content-highlighter.css"]
    }
  ],
  "options_ui": {
    "page": "dashboard/dashboard.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/fonts/Vazirmatn-Regular.woff2",
        "assets/fonts/Vazirmatn-Bold.woff2",
        "assets/fonts/Vazirmatn-Medium.woff2"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
